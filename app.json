{
  "expo": {
    "name": "doubleo-app",
    "slug": "doubleo-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/doubleo-coin-b.png",
    "scheme": "doubleoapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.orilevi.doubleo",
      "icon": "./assets/images/doubleo-coin-b.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/doubleo-coin-b.png",
        "backgroundColor": "#0B0F14"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/doubleo-coin-b.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/doubleo-coin.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0B0F14",
          "dark": {
            "backgroundColor": "#0B0F14"
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c6d4072a-8909-4494-b03b-95b28ba536a9"
      }
    }
  }
}
